# SignalIntel — Master Environment Configuration Template
# Copy to .env for local runtime execution

# ==========================================
# 1. Python Media & Intelligence Services (Port 8000)
# ==========================================
PORT=8000
SIGNALINTEL_VISION_MODEL=llava:7b
SIGNALINTEL_OCR_BIN=target/release/signalintel-ocr
SIGNALINTEL_BRAIN_URL=http://127.0.0.1:8080/api/v1/ingest

# ==========================================
# 2. Rust Brain & Gateway (Port 8080)
# ==========================================
GATEWAY_PORT=8080
QDRANT_URL=http://127.0.0.1:6333
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# 3. UI Console (Port 5173 / 3000)
# ==========================================
VITE_PYTHON_URL=http://localhost:8000
VITE_PYTHON_WS_URL=ws://localhost:8000
VITE_BRAIN_URL=http://localhost:8080
VITE_OPERATOR=J.WARREN
