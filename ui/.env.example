# SignalIntel UI — Environment Variables
# Copy to .env.local and fill in your values.

# Python FastAPI base URL (REST)
VITE_PYTHON_URL=http://localhost:8000

# Python FastAPI WebSocket base URL
VITE_PYTHON_WS_URL=ws://localhost:8000

# Rust Brain Gateway base URL
VITE_BRAIN_URL=http://localhost:8080

# Operator callsign displayed in the top bar
VITE_OPERATOR=J.WARREN
