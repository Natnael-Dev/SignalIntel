# ==============================================================================
# SignalIntel Python Media & Intelligence Services Dockerfile
# ==============================================================================
# Multi-stage build for FastAPI ingestion, audio transcription, & VLM vision.

FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies & multimedia libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python package dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

# Final slim runtime container
FROM python:3.11-slim as runtime

WORKDIR /app

# Install runtime multimedia libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application services and schemas
COPY services/ services/
COPY pyproject.toml .

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "services.main:app", "--host", "0.0.0.0", "--port", "8000"]
